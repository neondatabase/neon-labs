# Hosted OAuth configuration.
# Callback: ${APP_URL}/api/auth/callback/neon
APP_URL=http://localhost:3000
NEON_OAUTH_CLIENT_ID=
NEON_OAUTH_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Local-development fallback only. Production deliberately ignores this value.
NEON_API_KEY=

# Everything below is also local-development only. Hosted requests choose
# projects through the signed-in user's Neon account.

# Scopes the project list to an org, and names it in the sidebar.
NEON_ORG_ID=
# Override only; with an API key the name is read from the Neon API.
NEON_ORG_NAME=

# Skips the source project picker. Must be a real project id: the wizard
# reads its Postgres version to work out which targets are upgrades.
NEON_SOURCE_PROJECT_ID=

# Override only. Use the DIRECT host, no '-pooler', so introspection
# reaches a compute rather than the pooler.
NEON_SOURCE_CONNECTION_STRING=
